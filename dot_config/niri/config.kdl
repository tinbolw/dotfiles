workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"
workspace "6"
workspace "7"
workspace "8"
workspace "9"
workspace "discord"

environment {
	TERMINAL "foot"
	QT_QPA_PLATFORMTHEME "qt6ct"
}

input {
    keyboard {
        xkb {
            // If this section is empty, niri will fetch xkb settings
            // from org.freedesktop.locale1. You can control these using
            // localectl set-x11-keymap.
        }

        numlock
    }

    touchpad {
        natural-scroll
        scroll-factor horizontal=0.3 vertical=0.1
        tap
        dwt
    }

    mouse {
	accel-profile "flat"
    }

    trackpoint {

    }

    focus-follows-mouse max-scroll-amount="95%"
}

output "eDP-1" {
    scale 1.25
    transform "normal"
    position x=0 y=0
}

output "DP-1" {
    scale 1
}

output "HDMI-A-2" {
    position x=2560 y=0
}

layout {
    background-color "transparent"
    gaps 8
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
		off
        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    border {
        on

        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"

        urgent-color "#9b0000"
    }

    // You can enable drop shadows for windows.
    shadow {
	off
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts {

    }
}

spawn-sh-at-startup "$TERMINAL"
spawn-sh-at-startup "$TERMINAL"
spawn-sh-at-startup "zen"

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
	on
}

blur {
	passes 4
	offset 1.0
}

cursor {
    xcursor-theme "oguri-cap-multi"
    xcursor-size 24
}

include "./window-rules.kdl"
include "./layer-rules.kdl"
include "./binds.kdl"

include "dms/binds.kdl"
include "dms/cursor.kdl"
include "dms/outputs.kdl"

include "animations/glide-edit.kdl"
