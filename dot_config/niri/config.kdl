workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"
workspace "6"
workspace "7"
workspace "8"
workspace "9"
workspace "discord"

environment {
	TERMINAL "foot"
	QT_QPA_PLATFORMTHEME "qt6ct"
}

input {
    keyboard {
        xkb {
            // If this section is empty, niri will fetch xkb settings
            // from org.freedesktop.locale1. You can control these using
            // localectl set-x11-keymap.
        }

        numlock
    }

    touchpad {
        natural-scroll
        scroll-factor horizontal=0.3 vertical=0.1
        tap
        dwt
    }

    mouse {
	accel-profile "flat"
    }

    trackpoint {

    }

    focus-follows-mouse max-scroll-amount="95%"
}

output "eDP-1" {
    scale 1.25
    transform "normal"
    position x=0 y=0
}

output "DP-1" {
    scale 1
}

output "HDMI-A-2" {
    position x=2560 y=0
}

layout {
    background-color "transparent"
    gaps 8
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
		off
        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    border {
        on

        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"

        urgent-color "#9b0000"
    }

    // You can enable drop shadows for windows.
    shadow {
	off
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts {

    }
}

spawn-sh-at-startup "$TERMINAL"
spawn-sh-at-startup "$TERMINAL"
spawn-sh-at-startup "zen"

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
	on
}

window-rule {
    match at-startup=true
    match app-id="discord"
    match app-id="vesktop"
    match app-id="md.obsidian.Obsidian"
    open-focused false
}
window-rule {
    match app-id="org.gnome.Nautilus"
    match app-id="org.gnome.Papers"
    scroll-factor 3
}
window-rule {
    match app-id="discord"
    match app-id="vesktop"
    open-on-workspace "discord"
    open-maximized true
    // scroll-factor 0.3
}
window-rule {
    match app-id="zen"
    exclude title="^(Picture-in-Picture)$"
    open-on-workspace "2"
}
window-rule {
    match app-id="md.obsidian.Obsidian" title="UW"
    open-on-workspace "3"
    // scroll-factor 0.3
    open-maximized true
}
window-rule {
    match app-id="md.obsidian.Obsidian" title="Personal"
    open-on-workspace "4"
    // scroll-factor 0.3
    open-maximized true
}
window-rule {
    match app-id="Waydroid"
    open-maximized true
}
window-rule {
	match app-id="qalc"
	open-floating true
	default-column-width { fixed 800; }
	default-window-height { fixed 400; }
}
window-rule {
	match app-id="^(zen)$" title="^(Picture-in-Picture)$"
	open-floating true
}
// Work around WezTerm's initial configure bug
// by setting an empty default-column-width.
window-rule {
    // This regular expression is intentionally made as specific as possible,
    // since this is the default config, and we want no false positives.
    // You can get away with just app-id="wezterm" if you want.
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}
// Open the Firefox picture-in-picture player as floating by default.
window-rule {
    // This app-id regular expression will work for both:
    // - host Firefox (app-id is "firefox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Example: block out two password managers from screen capture.
// (This example rule is commented out with a "/-" in front.)
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"

    // Use this instead if you want them visible on third-party screenshot tools.
    // block-out-from "screencast"
}

// Example: enable rounded corners for all windows.
// (This example rule is commented out with a "/-" in front.)
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}
window-rule {
	match is-floating=true

	background-effect {
		xray false
	}
}
window-rule {
    match app-id="code"

    geometry-corner-radius 10
    clip-to-geometry true
}
layer-rule {
	match namespace="^duxlabs:.*"
	background-effect {
		xray false
	}
}
layer-rule {
  match namespace="vicinae"
  geometry-corner-radius 16
  background-effect {
    blur true
    xray false
  }
}
layer-rule {
    place-within-backdrop true
}
layer-rule {
    match layer="top"
    match layer="overlay"
    background-effect {
        xray false
    }
}
layer-rule {
    match namespace="skwd-wall"
    background-effect {
        blur true
        xray false
    }
}

include "./binds.kdl"

blur {
	passes 4
	offset 1.0
}

cursor {
    xcursor-theme "oguri-cap-multi"
    xcursor-size 24
}

include "dms/binds.kdl"

include "dms/cursor.kdl"
include "dms/outputs.kdl"

include "animations/glide-edit.kdl"
