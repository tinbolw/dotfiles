layout {
	//background-color "#0f1416"

    focus-ring {
        active-color "#86d1e9"
        inactive-color "#899296"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#86d1e9"
        inactive-color "#899296"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#86d1e9"
        inactive-color "#899296"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#86d1e980"
    }
}

overview {
	backdrop-color "#0f1416"
}

recent-windows {
    highlight {
        active-color "#86d1e9"
        urgent-color "#ffb4ab"
    }
}
